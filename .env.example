# Selecciona un proveedor: openai | anthropic | groq | gemini
LLM_PROVIDER=openai

# Modelo según el proveedor elegido.
# OpenAI: gpt-5.5
# Anthropic: claude-sonnet-4-5
# Groq: llama-3.3-70b-versatile
# Gemini: gemini-2.5-flash
LLM_MODEL=gpt-5.5

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=300
LLM_TOP_P=1.0

# API keys: completar SOLO en .env, nunca en Git.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
